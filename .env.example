# =============================================================================
#  MAJE – Server-Umgebung  (Ablage: /opt/MAJE/.env)
#  Kopieren mit:  cp .env.example .env   und dann Werte anpassen.
# =============================================================================

# --- Pflicht: JWT-Secret (langer Zufallswert!) -------------------------------
# Erzeugen:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_mit_langem_zufallswert_bitte

# --- Erlaubte CORS-Origins (kommagetrennt) -----------------------------------
# Für eine Netlify-PWA hier deren Domain eintragen, sonst "*" für Tests.
ALLOW_ORIGINS=*

# --- GID der Host-Gruppe "docker" (für den Docker-Socket-Zugriff) ------------
# Ermitteln mit:  getent group docker | cut -d: -f3
DOCKER_GID=999

# --- Sandbox-Ressourcen-Limits (pro Container) -------------------------------
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_CPU_QUOTA=1.0
SANDBOX_TIMEOUT_SECONDS=60

# --- Optionale API-Keys (alternativ in config/api_keys.py) -------------------
# Groq wird u. a. für die kostenlose Sprachnachrichten-Transkription genutzt.
GROQ_API_KEY=
TAVILY_API_KEY=

# --- Nur für den optionalen Caddy-HTTPS-Proxy (--profile proxy) --------------
# Muss per DNS auf diesen Server zeigen.
DOMAIN=maje.example.com
