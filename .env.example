# =============================================================================
#  MAJE – Server-Umgebung  (Ablage: /opt/MAJE/.env)
#  Kopieren mit:  cp .env.example .env   und dann Werte anpassen.
# =============================================================================

# --- Pflicht: JWT-Secret (langer Zufallswert!) -------------------------------
# Erzeugen:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_mit_langem_zufallswert_bitte

# --- Erlaubte CORS-Origins (kommagetrennt) -----------------------------------
# Für eine Netlify-PWA entweder die genaue Domain eintragen:
#   ALLOW_ORIGINS=https://maje-xyz.netlify.app
# ... oder (bequemer) per Regex alle Netlify-Subdomains erlauben:
#   ALLOW_ORIGIN_REGEX=https://([a-z0-9-]+\.)*netlify\.app
ALLOW_ORIGINS=*
# ALLOW_ORIGIN_REGEX=https://([a-z0-9-]+\.)*netlify\.app

# --- Sandbox: Netzwerk für generierten Code? ---------------------------------
# 0 = kein Netzwerk (sicherer, Standard)
# 1 = Sandbox-Code darf ins Internet (z.B. eigene Skripte/Pakete herunterladen)
#     Hinweis: pip_install/apt_install funktionieren IMMER (nutzen gezielt Netzwerk).
SANDBOX_ALLOW_NETWORK=0

# --- API-Keys-Datei (optional) ------------------------------------------------
# Standard im Container: /maje/keys/keys.json (persistent, UID 1000 -> beschreibbar).
# Nur setzen, wenn du einen anderen Pfad verwenden willst:
# MAJE_KEYS_FILE=/maje/keys/keys.json

# Optional: Verschlüsselung der Keys-Datei (Fernet). Leer = Datei im Klartext.
# Key erzeugen:  GET /settings/keys/newkey  (oder: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
# WICHTIG: Ohne diesen Wert kann eine verschlüsselte keys.json NICHT gelesen werden.
MAJE_KEYS_KEY=

# --- Sandbox-Ressourcen-Limits (pro Container) -------------------------------
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_CPU_QUOTA=1.0
SANDBOX_TIMEOUT_SECONDS=60

# --- Optionale API-Keys (alternativ in config/api_keys.py) -------------------
# Groq wird u. a. für die kostenlose Sprachnachrichten-Transkription genutzt.
GROQ_API_KEY=
TAVILY_API_KEY=

# --- Nur für den optionalen Caddy-HTTPS-Proxy (--profile proxy) --------------
# Muss per DNS auf diesen Server zeigen.
DOMAIN=maje.example.com
