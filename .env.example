# =====================================================================
# MAJE – Umgebungsvariablen (Optional, Keys können auch in config/api_keys.py eingetragen werden)
# =====================================================================

# Server-Einstellungen
PORT=8000
HOST=0.0.0.0
JWT_SECRET=super-secret-maje-jwt-token-change-me
ALLOW_ORIGINS=*

# Redis & Speicher
REDIS_URL=redis://localhost:6379/0
MAJE_WORKSPACE=/maje

# LLM API Keys (Werden automatisch mit config/api_keys.py gemerged)
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
TAVILY_API_KEY=

# Sandbox & Sicherheit
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_CPU_QUOTA=1.0
SANDBOX_TIMEOUT_SECONDS=60
